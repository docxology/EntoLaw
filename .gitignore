# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.benchmarks/
htmlcov/
.coverage
.coverage.*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Regenerated on every `scripts/check_docs_inventory.py` run; the gate is the
# check, not a committed copy of its output.
output/data/project_inventory.json

# Local code-index cache symlink (machine-specific); never tracked.
.codegraph

# CourtListener alert receipts and watch snapshots: local run evidence, regenerable
output/data/courtlistener/

# Run-local build evidence: regenerated on every validation/render and carrying
# wall-clock durations, run paths or interpreter state, so tracking them would
# make every clean rebuild dirty. The committed outputs below them are
# byte-stable (pinned SOURCE_DATE_EPOCH, see src/manuscript_variables.build_epoch).
output/data/local_validation_receipt.json
output/data/manuscript_render_receipt.json
output/quality/
output/pdf/*.log
output/pdf/*.blg
# The renderer's own staging tree and the web font bundle: the PDF and web
# export are already tracked under output/pdf/ and output/web/; both are
# regenerated by scripts/render_manuscript.py + scripts/finalize_web_export.py.
output/rendered/
output/web/assets/
# The transmission integrity strip (and the current local render PDF that
# embeds it on its two bookend pages) carries the template barcode timestamp,
# which the template's steganography resolver takes from the wall clock or the
# Git HEAD commit time, never SOURCE_DATE_EPOCH -- so no tracked copy can stay
# byte-stable across a commit. Both regenerate on every render; the historical
# v1.0.0 output/pdf/EntoLaw_combined.pdf remains tracked as the version of record.
output/figures/transmission_integrity_strip.png
output/pdf/EntoLaw_manuscript_combined.pdf
